APP_NAME="QuickContent"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Hostinger Shared — Use MySQL (create DB in hPanel) ──
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=quickcontent
DB_USERNAME=root
DB_PASSWORD=

# ── Shared-hosting safe drivers (NO REDIS) ──
BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Mail (Hostinger Email or Gmail SMTP) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="QuickContent"

# ── Payments ──
RAZORPAY_KEY=rzp_live_xxx
RAZORPAY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── App ──
PLATFORM_FEE_PERCENT=5
CREATOR_FEE_PERCENT=10
ESCROW_HOLD_HOURS=48
